(version 1)

(rule "Minimum Track Width"
	(constraint connection_width (min 0.09mm)))

(rule "Track to Track Clearance"
    (constraint clearance (min 0.09mm))
    (condition "A.Type == 'Track' && B.Type == 'Track'"))

(rule "Pad to Track Clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && B.Type == 'Track'"))

(rule "Clearance between Pads of Different Nets"
    (constraint clearance (min 0.15mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B.Net"))

(rule "Via Hole to Track Clearance"
    (constraint hole_clearance (min 0.2mm))
    (condition "A.Type == 'Via' && B.Type == 'Track'"))

(rule "Distance between Vias of Same Nets"
    (constraint hole_to_hole (min 0.22mm))
    (condition "A.Type == 'Via' && B.Type == 'Via' && A.Net == B.Net"))

(rule "Minimum Via Hole Size"
	(constraint hole_size (min 0.15mm)))

(rule "Minimum Via Diameter"
	(constraint via_diameter (min 0.25mm)))

(rule "Minimum Via Annular Ring"
	(constraint annular_width (min 0.1mm)))