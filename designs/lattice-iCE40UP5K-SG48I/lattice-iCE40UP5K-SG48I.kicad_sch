	(text "SPI flash PROM AT25EU0011A meets all of the requirements in iCE40 Programming and Configuration.\nHowever, will have to hold CRESET_B low until the PROM is ready (~300 us?) (BY25Q40GWTIG(T) is cheaper)\n\nWill also need a USB to SPI (FT2232HPQ supports both UART and SPI at the same time but\ncomes standard with both channels A and B being UART... so need to configure)"
		(exclude_from_sim no)
		(at -109.474 20.574 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7ca5ebfd-5a2a-467c-8840-4eb98fde2490")
	)
	(text "FPGA uses SPI mode 3 for reading from SPI FLASH."
		(exclude_from_sim no)
		(at -85.344 61.722 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ae6ac080-9f34-484d-b3a5-f1400c4bcd51")
	)
	(text "Thermal Calculations:\n\nLet's assume worst case, i.e., 0 lfm. This means thermal resistance is R = 37.1 C/W:\n\nP = T/R = (125C - 20C)/37.1 = 2.83 W => ICC = 2.83W/1.2V = 2.359 A max"
		(exclude_from_sim no)
		(at -110.236 48.768 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b37d4383-7aed-4e21-9875-5d8a7586eb02")
	)
	(text "ADD A HEADER FOR FTDI PINS"
		(exclude_from_sim no)
		(at 219.202 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d501b67e-3073-4e52-a5f9-013aaa1b0c07")
	)
	(text "Should be 3.3V for external SPI flash configuration?"
		(exclude_from_sim no)
		(at 436.118 70.104 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "eff2e22d-c8c2-4644-a764-ee90f75bf02a")
	)
